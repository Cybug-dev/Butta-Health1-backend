{
  "name": "butta-health-backend",
  "version": "0.1.0",
  "private": true,
  "description": "REST API foundation for Butta Health.",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc --project tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --project tsconfig.check.json",
    "test": "node --import tsx --test test/*.test.ts",
    "test:bootstrap": "node --import tsx --test test/bootstrap.test.ts",
    "test:auth": "node --import tsx --test test/auth.test.ts",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "db:check": "tsx src/scripts/check-db.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "argon2": "0.45.1",
    "cookie": "2.0.1",
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "helmet": "8.3.0",
    "jose": "6.2.12",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "24.13.4",
    "prisma": "7.10.0",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    },
    "prisma": {
      "mysql2": "3.24.4"
    }
  }
}
