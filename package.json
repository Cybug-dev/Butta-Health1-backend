{
  "name": "butta-health-backend",
  "version": "0.1.0",
  "private": true,
  "description": "REST API foundation for Butta Health.",
  "type": "commonjs",
  "main": "src/server.js",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "test": "node --test",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate && tsc --project tsconfig.prisma.json",
    "db:check": "node scripts/check-db.js"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "helmet": "8.3.0"
  },
  "devDependencies": {
    "nodemon": "3.1.14",
    "prisma": "7.10.0",
    "typescript": "7.0.2"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    },
    "prisma": {
      "mysql2": "3.24.4"
    }
  }
}
