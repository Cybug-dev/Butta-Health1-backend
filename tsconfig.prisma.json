{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "rootDir": "src/generated/prisma-source",
    "outDir": "src/generated/prisma-runtime",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmitOnError": true
  },
  "include": ["src/generated/prisma-source/**/*.ts"]
}
