NODE_ENV=development
PORT=5000
# Use a pooled application connection string in hosted environments when available.
DATABASE_URL=
CLIENT_URL=http://localhost:5173
# Generate a random 32-byte key locally; encode it as 64 hexadecimal characters.
JWT_SECRET=
JWT_EXPIRES_IN_SECONDS=3600
# Separate disposable Neon branch for integration tests; never use the application database.
TEST_DATABASE_URL=

# "ollama" (local, default), "gemini" (hosted, free tier), or "openrouter" (hosted, free-tier models).
AI_PROVIDER=ollama
# Only used when AI_PROVIDER=ollama. Defaults shown.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1
# Only required when AI_PROVIDER=gemini. Get a free key at https://aistudio.google.com/apikey.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Only required when AI_PROVIDER=openrouter. Get a free key at https://openrouter.ai/keys.
# Use a ":free" suffixed model to stay on the free tier.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=liquid/lfm-2.5-2.6b:free
# Optional public backend URL used for attachment links and OpenRouter attribution headers.
API_PUBLIC_URL=http://localhost:5000
