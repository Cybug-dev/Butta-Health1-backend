NODE_ENV=development
PORT=5000
# Copy the connection string from the existing butta-health project in Neon.
DATABASE_URL=
CLIENT_URL=http://localhost:5173
# Generate a random 32-byte key locally; encode it as 64 hexadecimal characters.
JWT_SECRET=
JWT_EXPIRES_IN_SECONDS=3600
# Separate disposable Neon branch for integration tests; never use the application database.
TEST_DATABASE_URL=
